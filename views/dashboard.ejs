<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
        
        /* Glass Effect */
        .glass { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.05); }
        .glass-card { background: linear-gradient(145deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.9)); border: 1px solid rgba(148, 163, 184, 0.1); }
        
        /* Animation */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .animate-enter { animation: fadeIn 0.4s ease-out forwards; opacity: 0; }
    </style>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                fontFamily: { sans: ['Space Grotesk', 'sans-serif'] },
                extend: { colors: { primary: '#6366f1', dark: '#020617' } }
            }
        }
    </script>
</head>
<body class="bg-dark text-slate-300 h-screen flex overflow-hidden selection:bg-primary selection:text-white">

    <aside class="hidden md:flex w-72 flex-col glass border-r-0 z-20 m-4 rounded-3xl">
        <div class="h-24 flex items-center px-8">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-indigo-500/20">
                <i class="ph-bold ph-lightning text-xl"></i>
            </div>
            <span class="ml-4 text-2xl font-bold text-white tracking-tight">Nexus</span>
        </div>
        <nav class="flex-1 px-4 py-6 space-y-2">
            <a href="#" class="flex items-center gap-4 px-6 py-4 bg-primary/10 text-primary rounded-2xl font-semibold transition-all hover:shadow-lg hover:shadow-primary/10">
                <i class="ph-fill ph-squares-four text-xl"></i> Dashboard
            </a>
            <a href="#" class="flex items-center gap-4 px-6 py-4 text-slate-400 hover:text-white hover:bg-white/5 rounded-2xl font-medium transition-all">
                <i class="ph-bold ph-users text-xl"></i> Users
            </a>
            <a href="#" class="flex items-center gap-4 px-6 py-4 text-slate-400 hover:text-white hover:bg-white/5 rounded-2xl font-medium transition-all">
                <i class="ph-bold ph-gear text-xl"></i> Settings
            </a>
        </nav>
        <div class="p-6">
            <div class="glass-card p-4 rounded-2xl text-center">
                <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Status</p>
                <div class="flex items-center justify-center gap-2">
                    <span class="relative flex h-3 w-3">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                    </span>
                    <span class="text-emerald-400 font-bold text-sm">Online</span>
                </div>
            </div>
        </div>
    </aside>

    <main class="flex-1 flex flex-col relative h-full overflow-hidden">
        <header class="md:hidden h-16 flex items-center justify-between px-6 glass border-b-0 m-2 rounded-2xl">
            <span class="text-xl font-bold text-white">Nexus</span>
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        </header>

        <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-8 scroll-smooth">
            
            <div class="animate-enter" style="animation-delay: 0.1s;">
                <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">Dashboard</h1>
                <p class="text-slate-500">Real-time overview of your bot's performance.</p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                <div class="glass-card p-6 rounded-3xl animate-enter" style="animation-delay: 0.2s;">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-blue-500/10 rounded-2xl text-blue-400"><i class="ph-fill ph-download-simple text-xl"></i></div>
                    </div>
                    <h3 id="stat-downloads" class="text-3xl md:text-4xl font-bold text-white mb-1"><%= stats.downloads %></h3>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Total Downloads</p>
                </div>
                <div class="glass-card p-6 rounded-3xl animate-enter" style="animation-delay: 0.3s;">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-purple-500/10 rounded-2xl text-purple-400"><i class="ph-fill ph-users text-xl"></i></div>
                    </div>
                    <h3 class="text-3xl md:text-4xl font-bold text-white mb-1"><%= stats.total_users %></h3>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Total Users</p>
                </div>
                <div class="glass-card p-6 rounded-3xl animate-enter" style="animation-delay: 0.4s;">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-emerald-500/10 rounded-2xl text-emerald-400"><i class="ph-fill ph-pulse text-xl"></i></div>
                    </div>
                    <h3 id="stat-active" class="text-3xl md:text-4xl font-bold text-white mb-1"><%= stats.active_now %></h3>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Active Session</p>
                </div>
                <div class="glass-card p-6 rounded-3xl animate-enter" style="animation-delay: 0.5s;">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-orange-500/10 rounded-2xl text-orange-400"><i class="ph-fill ph-timer text-xl"></i></div>
                    </div>
                    <h3 class="text-3xl md:text-4xl font-bold text-white mb-1"><%= Math.floor(uptime / 60) %>m</h3>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Uptime</p>
                </div>
            </div>

            <div class="glass-card p-6 rounded-3xl animate-enter" style="animation-delay: 0.6s;">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-lg font-bold text-white">Activity Growth</h3>
                    <select class="bg-slate-800 border-none text-xs rounded-lg px-3 py-1 text-slate-400 focus:ring-0">
                        <option>Last 7 Days</option>
                    </select>
                </div>
                <div class="h-64 w-full">
                    <canvas id="growthChart"></canvas>
                </div>
            </div>

            <div class="glass-card rounded-3xl overflow-hidden animate-enter" style="animation-delay: 0.7s;">
                <div class="p-6 border-b border-slate-700/50">
                    <h3 class="text-lg font-bold text-white">Recent Activity</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-slate-800/50 text-xs uppercase text-slate-400 font-semibold tracking-wider">
                            <tr>
                                <th class="px-6 py-4">User</th>
                                <th class="px-6 py-4">Stats</th>
                                <th class="px-6 py-4 text-right">Time</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800/50 text-sm">
                            <% dbUsers.forEach(u => { 
                               const total = u.downloads.total || u.downloads || 0;
                               const tk = u.downloads.tiktok || 0;
                               const yt = u.downloads.youtube || 0;
                               const fb = u.downloads.facebook || 0;
                               const ig = u.downloads.instagram || 0;
                            %>
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-slate-700 to-slate-800 flex items-center justify-center text-white font-bold shadow-inner">
                                            <%= u.firstName ? u.firstName.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-white"><%= u.firstName %></p>
                                            <p class="text-xs text-slate-500">ID: <%= u.telegramId %></p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-col gap-1">
                                        <span class="font-bold text-white text-base"><%= total %> <span class="text-xs font-normal text-slate-500">DLs</span></span>
                                        <div class="flex gap-2 text-[10px] uppercase font-bold tracking-wide opacity-80">
                                            <% if(tk > 0) { %><span class="text-cyan-400 bg-cyan-400/10 px-1.5 py-0.5 rounded">TK <%= tk %></span><% } %>
                                            <% if(yt > 0) { %><span class="text-rose-400 bg-rose-400/10 px-1.5 py-0.5 rounded">YT <%= yt %></span><% } %>
                                            <% if(fb > 0) { %><span class="text-blue-400 bg-blue-400/10 px-1.5 py-0.5 rounded">FB <%= fb %></span><% } %>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right text-slate-500 font-mono text-xs">
                                    <%= new Date(u.lastActive).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="h-20 md:hidden"></div>
        </div>

        <nav class="md:hidden fixed bottom-4 left-4 right-4 h-16 glass rounded-2xl flex items-center justify-around z-50 shadow-2xl border border-white/10">
            <a href="#" class="flex flex-col items-center justify-center text-primary w-full h-full">
                <i class="ph-fill ph-squares-four text-2xl mb-0.5"></i>
            </a>
            <a href="#" class="flex flex-col items-center justify-center text-slate-500 w-full h-full">
                <i class="ph-bold ph-users text-2xl mb-0.5"></i>
            </a>
            <a href="#" class="flex flex-col items-center justify-center text-slate-500 w-full h-full">
                <i class="ph-bold ph-gear text-2xl mb-0.5"></i>
            </a>
        </nav>
    </main>

    <script>
        // Setup Chart
        const ctx = document.getElementById('growthChart').getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(99, 102, 241, 0.4)');
        gradient.addColorStop(1, 'rgba(99, 102, 241, 0)');

        const labels = JSON.parse('<%- JSON.stringify(chartData.labels) %>');
        const dataValues = JSON.parse('<%- JSON.stringify(chartData.values) %>');
        
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'New Users',
                    data: dataValues,
                    borderColor: '#6366f1',
                    borderWidth: 3,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#6366f1',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1e293b', padding: 10, cornerRadius: 8 } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { family: 'Space Grotesk' } } },
                    y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8', font: { family: 'Space Grotesk' } } }
                }
            }
        });

        // Socket.IO for Live Updates
        const socket = io();
        socket.on('update_stats', (data) => {
            const elDl = document.getElementById('stat-downloads');
            const elAct = document.getElementById('stat-active');
            
            // Simple animation effect on change
            if(elDl.innerText != data.stats.downloads) {
                elDl.innerText = data.stats.downloads;
                elDl.classList.add('text-primary');
                setTimeout(() => elDl.classList.remove('text-primary'), 300);
            }
            
            elAct.innerText = data.userList.length;
        });
    </script>
</body>
</html>